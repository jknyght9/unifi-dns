# UniFi console
UNIFI_HOST=https://192.168.1.1
UNIFI_SITE=default
UNIFI_VERIFY_TLS=false

# Settings and Logs > Integrations > Create New API Key
#
# WARNING: this key is root-equivalent on the gateway. The UniFi settings
# endpoint returns the device SSH password in plaintext to any key holder.
# Treat it like a root password: never commit it, never log it, rotate it if
# it is ever exposed.
UNIFI_API_KEY=

# Signs session cookies. Anyone who knows this value can forge a login, so it
# must be random and secret. Generate one with:
#
#     openssl rand -hex 32
#
# Keep it stable: changing it invalidates every existing session.
SESSION_SECRET=

POSTGRES_PASSWORD=unifidns
POSTGRES_PORT=5433
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Authentication. Configure one of these before exposing the app.
# OIDC_ISSUER=https://authentik.example.com/application/o/unifi-dns/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://dns.example.com/api/auth/callback
#
# Or, if already behind a forward-auth proxy:
# TRUSTED_USER_HEADER=X-Forwarded-User
